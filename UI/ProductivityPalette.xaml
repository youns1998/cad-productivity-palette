<UserControl x:Class="CadProductivityPalette.UI.ProductivityPalette"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#202328" Foreground="#E8EAED"
             FontFamily="Segoe UI, Malgun Gothic" FontSize="12" MinWidth="280">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
        <SolidColorBrush x:Key="MutedBrush" Color="#ADB7C3" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E8EAED" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#292D33" />
            <Setter Property="BorderBrush" Value="#3E454F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="10,0,10,10" />
        </Style>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E8EAED" />
            <Setter Property="Background" Value="#343B44" />
            <Setter Property="BorderBrush" Value="#4A5563" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#414E5F" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#829BB6" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#83BAF4" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#23384E" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModeToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="54" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleTrack" Background="#4A535E" BorderBrush="#6A7480"
                                BorderThickness="1" CornerRadius="12">
                            <Grid>
                                <TextBlock x:Name="ToggleLabel" Text="OFF" FontSize="9" FontWeight="SemiBold"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,7,0" />
                                <Ellipse x:Name="ToggleKnob" Width="18" Height="18" Fill="#E8EAED"
                                         HorizontalAlignment="Left" Margin="2,0,0,0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleTrack" Property="Background" Value="#2F6F54" />
                                <Setter TargetName="ToggleTrack" Property="BorderBrush" Value="#63A987" />
                                <Setter TargetName="ToggleLabel" Property="Text" Value="ON" />
                                <Setter TargetName="ToggleLabel" Property="HorizontalAlignment" Value="Left" />
                                <Setter TargetName="ToggleLabel" Property="Margin" Value="7,0,0,0" />
                                <Setter TargetName="ToggleKnob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="ToggleKnob" Property="Margin" Value="0,0,2,0" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleTrack" Property="BorderBrush" Value="#B8D5F2" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ToggleTrack" Property="BorderBrush" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="#E8EAED" />
            <Setter Property="IsExpanded" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalContentAlignment="Stretch">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="HeaderBorder" Background="Transparent" Padding="2,9">
                                            <DockPanel>
                                                <TextBlock x:Name="Chevron" Text="+" Width="20" Foreground="#91B5DE" FontSize="14" />
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="Text" Value="−" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HeaderBorder" Property="Background" Value="#353D48" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="HeaderBorder" Property="Background" Value="#353D48" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter ContentSource="Header" />
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandedContent" Visibility="Collapsed" Margin="0,3,0,8" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandedContent" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="Background" Value="#202328" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical"
                                   Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                   ViewportSize="{TemplateBinding ViewportSize}"
                                   Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBorder" Background="#536071" CornerRadius="3" Margin="2" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#829BB6" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#ADB7C3" />
            <Setter Property="Padding" Value="20,11" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" BorderBrush="Transparent" BorderThickness="0,0,0,2"
                                Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#72ADF0" />
                                <Setter TargetName="TabBorder" Property="Background" Value="#2C3745" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#343D48" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="QuickToolTemplate">
            <Button Style="{StaticResource ToolButton}" ToolTip="{Binding ToolTip}"
                    Command="{Binding DataContext.ExecuteToolCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}">
                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="UsageToolTemplate">
            <Button Style="{StaticResource ToolButton}" ToolTip="{Binding ToolTip}"
                    Command="{Binding DataContext.ExecuteUsageToolCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Meta}" Foreground="{StaticResource MutedBrush}"
                               FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center" />
                </Grid>
            </Button>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="TwoColumns">
            <UniformGrid Columns="2" />
        </ItemsPanelTemplate>
        <DataTemplate x:Key="IssueTemplate">
            <Border Background="#23282F" CornerRadius="3" Padding="10" Margin="0,0,0,6" ToolTip="{Binding Description}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1" Text="{Binding Count, StringFormat=N0}" FontWeight="SemiBold" FontSize="16" />
                    <Border x:Name="Badge" Grid.Row="1" Background="#304837" HorizontalAlignment="Left"
                            CornerRadius="3" Padding="7,3" Margin="0,7,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Badge}" FontSize="10" />
                    </Border>
                    <Button Grid.Row="1" Grid.Column="1" Content="{Binding ActionLabel}"
                            Command="{Binding DataContext.SelectIssueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" Style="{StaticResource ToolButton}"
                            Visibility="{Binding CanSelect, Converter={StaticResource VisibleWhenTrue}}"
                            MinHeight="26" Padding="8,3" Margin="0,7,0,0" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                    <Setter TargetName="Badge" Property="Background" Value="#695022" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Information">
                    <Setter TargetName="Badge" Property="Background" Value="#3B4654" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Background="#191D23" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="150" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="CAD PRODUCTIVITY" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="선택한 객체부터, 필요한 도구까지" Foreground="{StaticResource MutedBrush}"
                               FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="심플 모드" Foreground="{StaticResource MutedBrush}" FontSize="10"
                               HorizontalAlignment="Center" Margin="0,0,0,3" />
                    <ToggleButton x:Name="SimpleModeToggle" Style="{StaticResource ModeToggle}"
                                  IsChecked="{Binding IsSimpleMode, Mode=TwoWay}"
                                  ToolTip="ON: 선택 정보와 기본 도구만 표시 / OFF: 전체 기능 표시" />
                </StackPanel>
            </Grid>
        </Border>
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0"
                    SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
            <TabItem Header="작업 도구">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,10,0,4">
                        <Border Style="{StaticResource Card}" BorderBrush="#526982">
                            <StackPanel>
                                <TextBlock Text="선택 객체" Style="{StaticResource SectionTitle}" Foreground="#A6C8ED" />
                                <TextBlock Text="{Binding SelectionHeading}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SelectionDescription}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,8" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding SelectionProperties}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90" /><ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource MutedBrush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding ContextActions}" ItemsPanel="{StaticResource TwoColumns}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource ToolButton}" Background="#2A4969" BorderBrush="#507BA5"
                                                    ToolTip="{Binding ToolTip}" Margin="2,9,2,0"
                                                    Command="{Binding DataContext.ExecuteContextCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border x:Name="SmartToolsCard" Style="{StaticResource Card}"
                                Visibility="{Binding IsFullMode, Converter={StaticResource VisibleWhenTrue}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="스마트 도구" Style="{StaticResource SectionTitle}" Margin="0"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="기록 초기화" Style="{StaticResource ToolButton}"
                                            Command="{Binding ClearUsageCommand}" MinHeight="26" Padding="8,3" Margin="2,0" />
                                </Grid>
                                <TabControl Background="Transparent" BorderThickness="0" Padding="0" Margin="-12,0,-12,-12">
                                    <TabItem Header="최근 사용" Padding="12,7">
                                        <Grid Margin="10,8,10,10">
                                            <TextBlock Text="도구를 실행하면 최근 사용 기록이 표시됩니다."
                                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="2,5">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasRecentTools}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <ItemsControl ItemsSource="{Binding RecentTools}" ItemsPanel="{StaticResource TwoColumns}"
                                                          ItemTemplate="{StaticResource UsageToolTemplate}" Margin="-2,0" />
                                        </Grid>
                                    </TabItem>
                                    <TabItem Header="자주 사용" Padding="12,7">
                                        <Grid Margin="10,8,10,10">
                                            <TextBlock Text="같은 도구를 2회 이상 사용하면 여기에 표시됩니다."
                                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="2,5">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasFrequentTools}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <ItemsControl ItemsSource="{Binding FrequentTools}" ItemsPanel="{StaticResource TwoColumns}"
                                                          ItemTemplate="{StaticResource UsageToolTemplate}" Margin="-2,0" />
                                        </Grid>
                                    </TabItem>
                                </TabControl>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="기본 도구" Style="{StaticResource SectionTitle}" />
                                <ItemsControl ItemsSource="{Binding EssentialTools}" ItemsPanel="{StaticResource TwoColumns}"
                                              ItemTemplate="{StaticResource QuickToolTemplate}" Margin="-2,0" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="AdditionalToolsCard" Style="{StaticResource Card}"
                                Visibility="{Binding IsFullMode, Converter={StaticResource VisibleWhenTrue}}">
                            <StackPanel>
                                <TextBlock Text="추가 도구" Style="{StaticResource SectionTitle}" Margin="0,0,0,2" />
                                <ItemsControl ItemsSource="{Binding QuickToolGroups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Expander>
                                                <Expander.Header>
                                                    <DockPanel LastChildFill="True">
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Tools.Count}" Foreground="{StaticResource MutedBrush}" Margin="10,0,0,0" />
                                                        <TextBlock Text="{Binding Name}" FontSize="11" />
                                                    </DockPanel>
                                                </Expander.Header>
                                                <ItemsControl ItemsSource="{Binding Tools}" ItemsPanel="{StaticResource TwoColumns}"
                                                              ItemTemplate="{StaticResource QuickToolTemplate}" />
                                            </Expander>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="DrawingStatusTab" Header="도면 점검"
                     Visibility="{Binding IsFullMode, Converter={StaticResource VisibleWhenTrue}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,10,0,4">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="MODEL SPACE" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding LastRefresh}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="다시 점검" Command="{Binding RefreshCommand}"
                                            Style="{StaticResource ToolButton}" ToolTip="선택 정보와 도면 점검 결과를 갱신합니다." />
                                </Grid>
                                <TextBlock Text="{Binding ReviewSummary}" Foreground="#B5CCE5" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12" />
                                <ItemsControl ItemsSource="{Binding DrawingIssues}" ItemTemplate="{StaticResource IssueTemplate}" />
                                <TextBlock Text="Model Space에 직접 배치된 객체 기준입니다." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="현재 도면" Style="{StaticResource SectionTitle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="현재 레이어" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding CurrentLayer}" ToolTip="{Binding CurrentLayer}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <Expander Header="스타일 · 객체 수" Margin="0,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" /><ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="26" /><RowDefinition Height="26" /><RowDefinition Height="26" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="문자 스타일" Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding CurrentTextStyle}" ToolTip="{Binding CurrentTextStyle}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="1" Text="치수 스타일" Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CurrentDimStyle}" ToolTip="{Binding CurrentDimStyle}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="2" Text="모델 객체" Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ObjectCount}" />
                                    </Grid>
                                </Expander>
                                <Expander Header="참고 정보 · 레이어 / 블록">
                                    <StackPanel>
                                        <TextBlock Text="정상적인 설정일 수 있으며 자동 수정하지 않습니다."
                                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8" />
                                        <ItemsControl ItemsSource="{Binding DrawingNotes}" ItemTemplate="{StaticResource IssueTemplate}" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
