<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AutoCADVersion Condition="'$(AutoCADVersion)' == ''">2027</AutoCADVersion>
    <TargetFramework Condition="'$(AutoCADVersion)' == '2026'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(AutoCADVersion)' != '2026'">net10.0-windows</TargetFramework>
    <AutoCADDir Condition="'$(AutoCADDir)' == ''">C:\Program Files\Autodesk\AutoCAD $(AutoCADVersion)</AutoCADDir>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <AssemblyName>CadProductivityPalette</AssemblyName>
    <RootNamespace>CadProductivityPalette</RootNamespace>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="AcMgd">
      <HintPath>$(AutoCADDir)\AcMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AcDbMgd">
      <HintPath>$(AutoCADDir)\AcDbMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AcCoreMgd">
      <HintPath>$(AutoCADDir)\AcCoreMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CheckAutoCADReferences" BeforeTargets="ResolveReferences" Condition="!Exists('$(AutoCADDir)/AcMgd.dll')"><Error Text="AutoCAD API DLL이 없습니다. -p:AutoCADDir=설치경로 를 지정하세요." /></Target>
</Project>
